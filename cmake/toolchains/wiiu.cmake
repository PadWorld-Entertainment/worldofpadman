set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR ppc)
set(WIIU TRUE CACHE BOOL "Build for Nintendo Wii U" FORCE)
set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro root")
if(NOT DEVKITPRO)
	set(DEVKITPRO "/opt/devkitpro")
endif()
set(DEVKITPPC "${DEVKITPRO}/devkitPPC")
set(WUT_ROOT "${DEVKITPRO}/wut")
set(PORTLIBS_PPC "${DEVKITPRO}/portlibs/ppc")
set(CMAKE_C_COMPILER "${DEVKITPPC}/bin/powerpc-eabi-gcc")
set(CMAKE_CXX_COMPILER "${DEVKITPPC}/bin/powerpc-eabi-g++")
set(CMAKE_AR "${DEVKITPPC}/bin/powerpc-eabi-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${DEVKITPPC}/bin/powerpc-eabi-ranlib" CACHE FILEPATH "")
set(ELF2RPL "${DEVKITPRO}/tools/bin/elf2rpl" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "${WUT_ROOT}" "${PORTLIBS_PPC}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(MACHDEP "-DESPRESSO -mcpu=750 -meabi -mhard-float -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${MACHDEP} -O3 -fno-strict-aliasing -D__WIIU__ -DWIIU -DWIIU_GX2BE -DWIIU_NATIVE_CGAME -I${WUT_ROOT}/include -I${PORTLIBS_PPC}/include")
set(CMAKE_CXX_FLAGS_INIT "${MACHDEP} -O3 -fno-strict-aliasing -fno-exceptions -fno-rtti -D__WIIU__ -DWIIU -DWIIU_GX2BE -DWIIU_NATIVE_CGAME -I${WUT_ROOT}/include -I${PORTLIBS_PPC}/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${MACHDEP} -specs=${WUT_ROOT}/share/wut.specs -L${WUT_ROOT}/lib -L${PORTLIBS_PPC}/lib -Wl,--gc-sections")
set(BUILD_CLIENT ON CACHE BOOL "" FORCE)
set(BUILD_SERVER OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_RENDERER_OPENGL2 OFF CACHE BOOL "" FORCE)
set(BUILD_RENDERER_VULKAN OFF CACHE BOOL "" FORCE)
set(USE_INTERNAL_LIBS OFF CACHE BOOL "" FORCE)
set(USE_RENDERER_DLOPEN OFF CACHE BOOL "" FORCE)
set(USE_OPENAL_DLOPEN OFF CACHE BOOL "" FORCE)
set(USE_HTTP OFF CACHE BOOL "" FORCE)
set(USE_VOIP OFF CACHE BOOL "" FORCE)
set(USE_MUMBLE OFF CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE OFF CACHE BOOL "" FORCE)
set(ENV{PKG_CONFIG_LIBDIR} "${PORTLIBS_PPC}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "${PORTLIBS_PPC}/lib/pkgconfig")
set(CMAKE_C_COMPILE_OPTIONS_PIE "")
set(CMAKE_CXX_COMPILE_OPTIONS_PIE "")
set(WUHBTOOL "${DEVKITPRO}/tools/bin/wuhbtool" CACHE FILEPATH "")
