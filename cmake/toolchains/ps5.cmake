set(PS5 TRUE CACHE BOOL "Build for PlayStation 5" FORCE)

if(DEFINED ENV{PS5_PAYLOAD_SDK} AND NOT "$ENV{PS5_PAYLOAD_SDK}" STREQUAL "")
  set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "PS5 Payload SDK path")
else()
  set(PS5_PAYLOAD_SDK "${CMAKE_CURRENT_LIST_DIR}/../../wop-sources/PS5_Vulkan/.deps/native/ps5-payload-sdk" CACHE PATH "PS5 Payload SDK path")
endif()

if(DEFINED ENV{PS5_VULKAN_DIR} AND NOT "$ENV{PS5_VULKAN_DIR}" STREQUAL "")
  set(PS5_VULKAN_DIR "$ENV{PS5_VULKAN_DIR}" CACHE PATH "PS5_Vulkan path")
else()
  set(PS5_VULKAN_DIR "${CMAKE_CURRENT_LIST_DIR}/../../wop-sources/PS5_Vulkan" CACHE PATH "PS5_Vulkan path")
endif()

include("${PS5_PAYLOAD_SDK}/toolchain/prospero.cmake")

add_compile_definitions(__PS5__ PS5 USE_VULKAN_API NO_VM_COMPILED)
add_compile_options(-fno-omit-frame-pointer -fno-strict-aliasing -fno-fast-math)

set(BUILD_CLIENT ON CACHE BOOL "" FORCE)
set(BUILD_SERVER OFF CACHE BOOL "" FORCE)
set(BUILD_RENDERER_OPENGL2 OFF CACHE BOOL "" FORCE)
set(BUILD_RENDERER_VULKAN ON CACHE BOOL "" FORCE)
set(USE_RENDERER_DLOPEN OFF CACHE BOOL "" FORCE)
set(USE_VOIP OFF CACHE BOOL "" FORCE)
set(USE_CURL OFF CACHE BOOL "" FORCE)
set(USE_MUMBLE OFF CACHE BOOL "" FORCE)
set(USE_CODEC_VORBIS OFF CACHE BOOL "" FORCE)
set(USE_CODEC_OPUS OFF CACHE BOOL "" FORCE)
set(USE_LOCAL_HEADERS ON CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_RENDERER_OPENGL1 OFF CACHE BOOL "" FORCE)
set(USE_HTTP OFF CACHE BOOL "" FORCE)
